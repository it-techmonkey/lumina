<span class="lumina-stars" style="--star-size:{{ size | default: 16 }}px" role="img" aria-label="{{ rating | round: 1 }} out of 5 stars">{% for star in (1..5) %}{% assign threshold = star | minus: 0.25 %}<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" {% if rating >= threshold %}fill="currentColor"{% else %}fill="none"{% endif %}><path d="M10 1.5l2.58 5.23 5.77.84-4.17 4.06.98 5.74L10 14.65l-5.16 2.72.98-5.74L1.65 7.57l5.77-.84L10 1.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>{% endfor %}</span>

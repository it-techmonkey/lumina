<div class="lumina-product-trust" {{ block.shopify_attributes }}>
 <p>{{ block.settings.heading | escape }}</p>
 <div class="lumina-product-trust-grid">{% for index in (1..3) %}{% capture title_key %}title_{{ index }}{% endcapture %}{% capture text_key %}text_{{ index }}{% endcapture %}<div><span class="lumina-product-trust-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{% case index %}{% when 1 %}<path d="M1 3h15v13H1zM16 8h4l3 3v5h-7"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>{% when 2 %}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>{% when 3 %}<path fill="currentColor" stroke="none" d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/>{% endcase %}</svg></span>{% if index == 3 and block.settings.use_review_rating %}{% assign rating = product.metafields.reviews.rating.value.rating | default: 0 %}<strong>{{ rating | round: 1 }} / 5 {{ block.settings.stars_label | escape }}</strong><span>{{ product.metafields.reviews.rating_count.value | default: 0 }} {{ block.settings.reviews_label | escape }}</span>{% else %}<strong>{{ block.settings[title_key] | escape }}</strong><span>{{ block.settings[text_key] | escape }}</span>{% endif %}</div>{% endfor %}</div>
</div>

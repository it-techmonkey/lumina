{% assign media_limit = section.settings.max_media | default: 20 %}
{% assign product_media_count = product.media.size | at_most: media_limit %}
<div data-gallery class="flex flex-col gap-3 w-full">
 <div class="relative overflow-hidden rounded-2xl aspect-4/5 bg-[#eaedf0]" data-media-stage>
  {% if section.settings.media_source == 'product' and product.media.size > 0 %}
   {% for media in product.media limit: media_limit %}<div class="lumina-media-slide" data-media-index="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>{% case media.media_type %}{% when 'image' %}{{ media | image_url: width: 1800 | image_tag: class: 'lumina-gallery-image', loading: 'eager' }}{% when 'video' %}{{ media | video_tag: controls: true, image_size: '1200x', class: 'lumina-gallery-image' }}{% when 'external_video' %}{{ media | external_video_tag: class: 'lumina-gallery-image' }}{% when 'model' %}{{ media | model_viewer_tag: class: 'lumina-gallery-image', reveal: 'interaction', toggleable: true }}{% endcase %}</div>{% endfor %}
  {% else %}
   {% assign image_blocks = section.blocks | where: 'type', 'image' %}
   {% for block in image_blocks %}<div class="lumina-media-slide" data-media-index="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1800 | image_tag: class: 'lumina-gallery-image', loading: 'eager' }}{% else %}{% assign filename = 'product-gallery-' | append: block.settings.original | append: '.webp' %}<img class="lumina-gallery-image" src="{{ filename | asset_url }}" width="1200" height="1500" alt="{{ block.settings.alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">{% endif %}</div>{% endfor %}
  {% endif %}
  <button type="button" data-native-zoom class="lumina-gallery-zoom" aria-label="Enlarge product image">↗</button>
  <button type="button" data-media-step="-1" class="lumina-gallery-prev" aria-label="Previous image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button><button type="button" data-media-step="1" class="lumina-gallery-next" aria-label="Next image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button>
 </div>
 <div class="lumina-gallery-dots" aria-label="Product images">{% if section.settings.media_source == 'product' and product.media.size > 0 %}{% assign dot_media = product.media %}{% else %}{% assign dot_media = image_blocks %}{% endif %}{% for item in dot_media limit: media_limit %}<button type="button" data-media-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div>
 <div class="lumina-gallery-thumbs">
  {% if section.settings.media_source == 'product' and product.media.size > 0 %}{% for media in product.media limit: 5 %}<button type="button" data-media-thumb="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show media {{ forloop.index }}" {% if forloop.index == 5 and product.media.size > 5 %}data-gallery-more{% endif %}>{{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy' }}{% if forloop.index == 5 and product.media.size > 5 %}<span>+{{ product_media_count | minus: 4 }}</span>{% endif %}</button>{% endfor %}
  {% else %}{% for block in image_blocks limit: 5 %}<button type="button" data-media-thumb="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}" {% if forloop.index == 5 and image_blocks.size > 5 %}data-gallery-more{% endif %}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy' }}{% else %}{% assign filename = 'product-gallery-' | append: block.settings.original | append: '.webp' %}<img src="{{ filename | asset_url }}" width="200" height="200" alt="{{ block.settings.alt | escape }}" loading="lazy">{% endif %}{% if forloop.index == 5 and image_blocks.size > 5 %}<span>+{{ image_blocks.size | minus: 4 }}</span>{% endif %}</button>{% endfor %}{% endif %}
 </div>
</div>

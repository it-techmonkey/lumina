<div class="lumina-editable-section {% if section.settings.background != blank %}lumina-background-override{% endif %} lumina-width-{{ section.settings.content_width }}" style="--section-background:{{ section.settings.background }};padding-top:{{ section.settings.spacing_top }}px;padding-bottom:{{ section.settings.spacing_bottom }}px"><section class="bg-[#f9fafb] w-full flex flex-col items-center py-16 lg:py-[96px] px-6"><div class="w-full max-w-[1280px] grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-[64px] items-center"><div class="flex flex-col items-start gap-4 max-w-[550px] w-full lg:hidden order-1"><span class="font-sans font-medium text-[#4051b5] text-[12px] tracking-[1.2px] uppercase leading-[16px]">{{ section.settings.content_0 | escape }}</span><h2 class="font-playfair font-medium text-[#131720] text-4xl leading-tight flex flex-col mb-0">{{ section.settings.heading_0 }}</h2></div><div class="flex flex-col items-start gap-4 max-w-[550px] justify-self-center lg:justify-self-start order-3 lg:order-1"><span class="hidden lg:block font-sans font-medium text-[#4051b5] text-[12px] tracking-[1.2px] uppercase leading-[16px]">{{ section.settings.content_1 | escape }}</span><h2 class="hidden lg:flex font-playfair font-medium text-[#131720] text-[48px] leading-[48px] flex-col mb-1">{{ section.settings.heading_1 }}</h2><p class="font-sans font-normal text-[#657186] text-base lg:text-[16px] leading-[26px]">{{ section.settings.content_2 | escape }}</p><div class="flex flex-col gap-8 mt-6">{% for block in section.blocks %}{% case block.type %}{% when 'step_0' %}<div class="flex gap-5 items-start" {{ block.shopify_attributes }}><div class="bg-[#eaedf0] rounded-full w-12 h-12 flex items-center justify-center shrink-0"><span class="font-playfair font-semibold text-[#657186] text-[14px] leading-[20px]">{{ block.settings.content_0 | escape }}</span></div><div class="flex flex-col gap-[3.4px] pt-1"><h3 class="font-playfair font-medium text-[#131720] text-[18px] leading-[28px]">{{ block.settings.content_1 | escape }}</h3><p class="font-sans font-normal text-[#657186] text-[14px] leading-[22.75px]">{{ block.settings.content_2 | escape }}</p><p class="font-sans font-medium text-[#4051b5] text-[12px] leading-[16px] mt-1">{{ block.settings.content_3 | escape }}</p></div></div>{% when 'step_1' %}<div class="flex gap-5 items-start" {{ block.shopify_attributes }}><div class="bg-[#eaedf0] rounded-full w-12 h-12 flex items-center justify-center shrink-0"><span class="font-playfair font-semibold text-[#657186] text-[14px] leading-[20px]">{{ block.settings.content_0 | escape }}</span></div><div class="flex flex-col gap-[3.4px] pt-1"><h3 class="font-playfair font-medium text-[#131720] text-[18px] leading-[28px]">{{ block.settings.content_1 | escape }}</h3><p class="font-sans font-normal text-[#657186] text-[14px] leading-[22.75px]">{{ block.settings.content_2 | escape }}</p><p class="font-sans font-medium text-[#4051b5] text-[12px] leading-[16px] mt-1">{{ block.settings.content_3 | escape }}</p></div></div>{% when 'step_2' %}<div class="flex gap-5 items-start" {{ block.shopify_attributes }}><div class="bg-[#eaedf0] rounded-full w-12 h-12 flex items-center justify-center shrink-0"><span class="font-playfair font-semibold text-[#657186] text-[14px] leading-[20px]">{{ block.settings.content_0 | escape }}</span></div><div class="flex flex-col gap-[3.4px] pt-1"><h3 class="font-playfair font-medium text-[#131720] text-[18px] leading-[28px]">{{ block.settings.content_1 | escape }}</h3><p class="font-sans font-normal text-[#657186] text-[14px] leading-[22.75px]">{{ block.settings.content_2 | escape }}</p><p class="font-sans font-medium text-[#4051b5] text-[12px] leading-[16px] mt-1">{{ block.settings.content_3 | escape }}</p></div></div>{% endcase %}{% endfor %}</div></div><div class="relative w-full h-[500px] lg:h-[730px] order-2 lg:order-2"><div class="relative w-full h-full rounded-[24px] overflow-hidden shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)] bg-zinc-200">{% if section.settings.content_6 != blank %}<img width="1600" height="1200" class="object-cover" src="{{ section.settings.content_6 | image_url: width: 2000 }}" alt="{{ section.settings.content_7 | escape }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%">{% else %}<img width="1600" height="1200" class="object-cover" src="{{ 'home-measuring-guide-img.webp' | asset_url }}" alt="{{ section.settings.content_7 | escape }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%">{% endif %}</div><div class="absolute top-6 right-0 lg:-right-8 bg-[#f9fafb] border border-[#dbe0e6] rounded-[16px] p-[21px] w-[150px] lg:w-[176px] shadow-[0_10px_15px_-3px_rgba(0,0,0,0.1),0_4px_6px_-4px_rgba(0,0,0,0.1)] z-10 flex flex-col gap-1"><span class="font-sans font-normal text-[#657186] text-[12px] leading-[16px]">{{ section.settings.content_3 | escape }}</span><span class="font-playfair font-semibold text-[#131720] text-[24px] leading-[32px]">{{ section.settings.content_4 | escape }}</span><span class="font-sans font-normal text-[#657186] text-[12px] leading-[16px]">{{ section.settings.content_5 | escape }}</span></div></div></div></section>
</div>


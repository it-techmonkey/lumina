<dialog id="LuminaFitPromise" class="lumina-dialog" aria-labelledby="LuminaFitPromiseTitle" data-editor-dialog>
  <button type="button" class="lumina-dialog-close" data-dialog-close aria-label="Close fit promise">×</button>
  <div class="lumina-dialog-inner"><h2 id="LuminaFitPromiseTitle">{{ section.settings.heading | escape }}</h2><p class="text-sm text-[#657186] mb-6">{{ section.settings.intro | escape }}</p>
  {% for block in section.blocks %}<details class="lumina-accordion" {{ block.shopify_attributes }}><summary><span>{{ block.settings.heading | escape }}</span><span aria-hidden="true">+</span></summary><div class="lumina-richtext">{{ block.settings.content }}</div></details>{% endfor %}</div>
</dialog>
{% schema %}
{
  "name": "Fit promise dialog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Lumina Fit Promise"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Buying custom blinds online should feel straightforward. This is what you can expect with Lumina."
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise detail",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Promise detail"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your promise details.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "promise",
        "settings": {
          "heading": "Accurate measurement guidance",
          "content": "<p>Every blind is cut to the exact width and drop you enter at checkout, with a standard +/-4mm manufacturing tolerance. Not sure you measured right? <a href=\"/?view=measuring-guide\" target=\"_blank\" rel=\"noopener noreferrer\">View our measuring guide</a> before you order, or email us a photo of your window at <strong>info@luminablackoutblinds.com</strong> and we'll help you get it right.</p>"
        }
      },
      {
        "type": "promise",
        "settings": {
          "heading": "30-night home trial",
          "content": "<p>Install your Lumina blind and live with it for up to 30 nights. If it's not right for your space, you can start a return — even though it was made to your exact measurements, color, and opening direction. Email us at <strong>info@luminablackoutblinds.com</strong> within 30 nights of delivery and we'll walk you through the next steps.</p>"
        }
      },
      {
        "type": "promise",
        "settings": {
          "heading": "1-year manufacturer's guarantee",
          "content": "<p>Every blind is covered against manufacturing faults for a full year from delivery. If a fault is confirmed, we'll repair or replace it at no extra cost.</p>"
        }
      },
      {
        "type": "promise",
        "settings": {
          "heading": "Fault protection on delivery",
          "content": "<p>If your blind arrives damaged or with a manufacturing fault, contact us within <strong>3 business days</strong> of delivery with your order number and photos. We aim to respond within 1 business day and will arrange a free replacement once the fault is confirmed.</p>"
        }
      },
      {
        "type": "promise",
        "settings": {
          "heading": "Still unsure about your window?",
          "content": "<p>Lumina blinds are designed for recessed windows with a recess depth between <strong>5mm and 80mm</strong>. If you're not sure your window qualifies, email us a photo at <strong>info@luminablackoutblinds.com</strong> and we'll confirm fit before you order.</p>"
        }
      }
    ]
  }
}
{% endschema %}

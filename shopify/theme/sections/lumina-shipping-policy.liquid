{{ block.shopify_attributes }}><h2 class="text-xl font-semibold mb-4">{{ block.settings.content_0 | escape }}</h2><div class="text-gray-700 leading-relaxed [&amp;_p+p]:mt-3 [&amp;_p+ul]:mt-3 [&amp;_ul+p]:mt-3 [&amp;_ul]:mt-3 [&amp;_ul]:list-disc [&amp;_ul]:space-y-2 [&amp;_ul]:pl-5"><p>{{ block.settings.content_1 | escape }}</p></div></div>{% when 'policy_4' %}<div class="py-8" {{ block.shopify_attributes }}><h2 class="text-xl font-semibold mb-4">{{ block.settings.content_0 | escape }}</h2><div class="text-gray-700 leading-relaxed [&amp;_p+p]:mt-3 [&amp;_p+ul]:mt-3 [&amp;_ul+p]:mt-3 [&amp;_ul]:mt-3 [&amp;_ul]:list-disc [&amp;_ul]:space-y-2 [&amp;_ul]:pl-5"><p>{{ block.settings.content_1 | escape }} <a href="{% if block.settings.content_4 != blank %}{{ block.settings.content_4 }}{% else %}mailto:info@luminablackoutblinds.com{% endif %}" class="underline">{{ block.settings.content_2 | escape }}</a>{{ block.settings.content_3 | escape }}</p></div></div>{% when 'policy_5' %}<div class="py-8" {{ block.shopify_attributes }}><h2 class="text-xl font-semibold mb-4">{{ block.settings.content_0 | escape }}</h2><div class="text-gray-700 leading-relaxed [&amp;_p+p]:mt-3 [&amp;_p+ul]:mt-3 [&amp;_ul+p]:mt-3 [&amp;_ul]:mt-3 [&amp;_ul]:list-disc [&amp;_ul]:space-y-2 [&amp;_ul]:pl-5"><p>{{ block.settings.content_1 | escape }}</p></div></div>{% when 'policy_6' %}<div class="mt-10 pt-8 border-t border-gray-200" {{ block.shopify_attributes }}><h2 class="text-xl font-semibold mb-4">{{ block.settings.content_0 | escape }}</h2><p class="text-gray-700 leading-relaxed">{{ block.settings.content_1 | escape }} <a href="{% if block.settings.content_4 != blank %}{{ block.settings.content_4 }}{% else %}mailto:info@luminablackoutblinds.com{% endif %}" class="underline">{{ block.settings.content_2 | escape }}</a>{{ block.settings.content_3 | escape }}</p></div>{% endcase %}{% endfor %}</div></div></div>

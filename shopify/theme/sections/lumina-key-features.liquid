<div class="lumina-editable-section {% if section.settings.background != blank %}lumina-background-override{% endif %} lumina-width-{{ section.settings.content_width }}" style="--section-background:{{ section.settings.background }};padding-top:{{ section.settings.spacing_top }}px;padding-bottom:{{ section.settings.spacing_bottom }}px"><section class="bg-white w-full py-16 md:py-20 px-4 md:px-6"><div class="max-w-[1248px] mx-auto flex flex-col gap-10"><div class="flex flex-col gap-4 text-center items-center"><span class="text-[#4051b5] font-sans font-medium text-[12px] tracking-[1.2px] uppercase">{{ section.settings.content_0 | escape }}</span><h2 class="text-[#131720] text-4xl lg:text-[48px] font-playfair font-medium leading-tight">{{ section.settings.content_1 | escape }}<span class="italic">{{ section.settings.content_2 | escape }}</span></h2></div><div class="grid grid-cols-1 md:grid-cols-3 gap-6">{% for block in section.blocks %}{% case block.type %}{% when 'feature_0' %}<div class="bg-[#eaedf0] rounded-[16px] p-6 flex flex-col gap-5 sm:flex-row sm:items-start" {{ block.shopify_attributes }}><div class="bg-[#f9fafb] rounded-xl w-12 h-12 shrink-0 flex items-center justify-center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#131720]"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg></div><div class="flex flex-col gap-1.5"><h3 class="font-playfair font-medium text-[#131720] text-[16px]">{{ block.settings.content_0 | escape }}</h3><p class="font-sans text-[14px] text-[#657186] leading-relaxed">{{ block.settings.content_1 | escape }}</p></div></div>{% when 'feature_1' %}<div class="bg-[#eaedf0] rounded-[16px] p-6 flex flex-col gap-5 sm:flex-row sm:items-start" {{ block.shopify_attributes }}><div class="bg-[#f9fafb] rounded-xl w-12 h-12 shrink-0 flex items-center justify-center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#131720]"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></div><div class="flex flex-col gap-1.5"><h3 class="font-playfair font-medium text-[#131720] text-[16px]">{{ block.settings.content_0 | escape }}</h3><p class="font-sans text-[14px] text-[#657186] leading-relaxed">{{ block.settings.content_1 | escape }}</p></div></div>{% when 'feature_2' %}<div class="bg-[#eaedf0] rounded-[16px] p-6 flex flex-col gap-5 sm:flex-row sm:items-start" {{ block.shopify_attributes }}><div class="bg-[#f9fafb] rounded-xl w-12 h-12 shrink-0 flex items-center justify-center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#131720]"><path d="M12 2v20"/><path d="M2 12h20"/><path d="M4.93 4.93l14.14 14.14"/><path d="M19.07 4.93L4.93 19.07"/></svg></div><div class="flex flex-col gap-1.5"><h3 class="font-playfair font-medium text-[#131720] text-[16px]">{{ block.settings.content_0 | escape }}</h3><p class="font-sans text-[14px] text-[#657186] leading-relaxed">{{ block.settings.content_1 | escape }}</p></div></div>{% endcase %}{% endfor %}</div></div></section>
</div>


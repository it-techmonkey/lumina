<section class="lumina-container lumina-content-page"><h1>{{ section.settings.heading | escape }}</h1>{% assign guide_url = section.settings.url %}{% if guide_url == blank %}{% assign guide_url = section.settings.filename | asset_url %}{% endif %}{% if section.settings.filename contains '.png' %}<a href="{{ guide_url }}" target="_blank" rel="noopener"><img src="{{ guide_url }}" width="1600" height="2400" alt="{{ section.settings.heading | escape }}" loading="lazy" class="max-w-full h-auto"></a>{% else %}<p class="mb-8">Download the step-by-step fitting guide for your Lumina blind.</p><a class="lumina-button" href="{{ guide_url }}" target="_blank" rel="noopener">Open fitting guide (PDF)</a>{% endif %}</section>

{% schema %}
{
  "name": "Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Measuring guide"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Guide URL override"
    },
    {
      "type": "select",
      "id": "filename",
      "label": "Original guide",
      "default": "guide-lumina-measuring-guide.png",
      "options": [
        {
          "value": "guide-lumina-measuring-guide.png",
          "label": "Measuring guide"
        },
        {
          "value": "guide-lumina_honeycomb_fitting_guide.pdf",
          "label": "Fitting guide PDF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide"
    }
  ]
}
{% endschema %}
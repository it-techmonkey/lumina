{% assign review_product = product | default: section.settings.product | default: settings.featured_product %}
{% if review_product == blank %}{% assign review_product = all_products['honeycomb-blackout-blind'] %}{% endif %}
<section id="reviews" class="lumina-judgeme-section" style="background:{{ section.settings.background }};padding-block:{{ section.settings.padding }}px">
 {% if section.settings.layout == 'original' and review_product.metafields.judgeme.review_widget_data.value.reviews.size > 0 %}
 <div class="lumina-reviews-original">{% render 'lumina-review-snapshot', review_product: review_product, section: section %}</div>
 {% else %}
 <div class="lumina-container">
  {% if section.settings.heading != blank %}<h2 class="font-playfair text-4xl md:text-[48px] text-center mb-10">{{ section.settings.heading | escape }}</h2>{% endif %}
  {% if section.blocks.size > 0 %}
   {% for block in section.blocks %}{% render block %}{% endfor %}
  {% elsif section.settings.widget == 'carousel' %}
   {% if shop.metafields.judgeme.featured_carousel != blank %}<div class="jdgm-carousel-wrapper" data-auto-install="false">{{ shop.metafields.judgeme.featured_carousel }}</div>{% elsif request.design_mode %}<p class="lumina-editor-note">Add a Judge.me carousel app block here, or feature reviews in Judge.me.</p>{% endif %}
  {% elsif review_product != blank %}
   {% render 'lumina-judgeme-widget', product: review_product %}
  {% endif %}
  {% if request.design_mode %}<p class="lumina-editor-note">Reviews are provided by Judge.me. Enable the Judge.me app embed for this theme. You can add its native app blocks here to choose a different widget. No sample reviews are stored in the theme.</p>{% endif %}
 </div>
 {% endif %}
</section>

{% schema %}
{
  "name": "Judge.me reviews",
  "settings": [
    {"type":"select","id":"layout","label":"Review layout","default":"original","options":[{"value":"original","label":"Original Lumina design"},{"value":"app","label":"Judge.me full widget"}]},
    {"type":"text","id":"snapshot_heading","label":"Rating heading","default":"Rating snapshot"},
    {"type":"text","id":"customer_heading","label":"Review heading","default":"Customer reviews"},
    {"type":"text","id":"intro","label":"Introduction","default":"Read feedback from customers."},
    {"type":"text","id":"more_label","label":"View more label","default":"View more reviews"},
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product for homepage reviews"
    },
    {
      "type": "select",
      "id": "widget",
      "label": "Default widget",
      "default": "product",
      "options": [
        {
          "value": "product",
          "label": "Product review widget"
        },
        {
          "value": "carousel",
          "label": "Featured reviews carousel"
        }
      ]
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical spacing",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Judge.me reviews"
    }
  ]
}
{% endschema %}

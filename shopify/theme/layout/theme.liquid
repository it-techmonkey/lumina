<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0a0c10">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% unless settings.enable_purchasing %}<meta name="robots" content="noindex,nofollow">{% endunless %}
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
    {{ 'lumina-fonts.css' | asset_url | stylesheet_tag }}
    {{ 'lumina-utilities.css' | asset_url | stylesheet_tag }}
    {{ 'lumina-theme.css' | asset_url | stylesheet_tag }}
    {{ 'lumina-fidelity.css' | asset_url | stylesheet_tag }}
    {{ 'lumina-product.css' | asset_url | stylesheet_tag }}
    {% style %}
      :root { --lumina-accent: {{ settings.accent_color | default: '#4051b5' }}; --lumina-ink: {{ settings.ink_color | default: '#131720' }}; }
      {% if settings.custom_fonts %}
        {{ settings.heading_font | font_face: font_display: 'swap' }}
        {{ settings.body_font | font_face: font_display: 'swap' }}
        :root { --font-lora: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }}; --font-manrope: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }}; }
      {% endif %}
    {% endstyle %}
    {{ content_for_header }}
    {% if settings.judgeme_legacy_loader %}{{ shop.metafields.judgeme.settings }}{% endif %}
    <script src="{{ 'lumina-theme.js' | asset_url }}" defer></script>
    <script src="{{ 'lumina-product.js' | asset_url }}" defer></script>
  </head>
  <body data-purchasing="{{ settings.enable_purchasing }}" data-root-url="{{ routes.root_url }}">
    <a href="#MainContent" class="lumina-skip">Skip to content</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    {% render 'lumina-dialogs' %}
    {% section 'lumina-fit-promise' %}
    {% render 'lumina-cart-drawer' %}
    {% section 'lumina-welcome-popup' %}
  </body>
</html>
